[Unit]
Description=OpenClaw Execution Plane - Tank
After=network.target wg-quick@wg0.service
Requires=wg-quick@wg0.service

[Service]
Type=simple
User=openclaw
Environment=EXEC_NODE_NAME=dell-tank
Environment=EXEC_HMAC_SECRET=HMAC_SECRET_PENDIENTE
ExecStart=/usr/bin/python3 /opt/openclaw/execution_plane/executor.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/openclaw/executor.log
StandardError=append:/var/log/openclaw/executor.log

[Install]
WantedBy=multi-user.target
